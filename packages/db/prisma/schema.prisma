generator client {
  provider      = "prisma-client-js"
  output        = "../../../apps/web/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id               String     @id @default(cuid())
  name             String
  departmentId     String
  instructorId     String
  enrollmentStatus  String     @default("ACTIVE")
  age               Int?
  gender            String?
  school            String?
  grade             String?
  community         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  department        Department @relation(fields: [departmentId], references: [id])
  instructor        User       @relation("InstructorStudents", fields: [instructorId], references: [id])
  sessionAttendance SessionAttendance[]

  @@index([instructorId])
  @@index([departmentId])
}

model Department {
  id                 String              @id @default(cuid())
  name               String
  parentDepartmentId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  boardPolicies      BoardPolicy[]
  dailyEntries       DailyEntry[]
  dashboardSnapshots DashboardSnapshot[]
  parent             Department?         @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  children           Department[]        @relation("DepartmentHierarchy")
  monthlyReports     MonthlyReport[]
  outcomeRecords     OutcomeRecord[]
  pendingActions     PendingAction[]
  students           Student[]
  users               User[]
  weeklyReports       WeeklyReport[]
  youthCodingSessions YouthCodingSession[]

  @@index([parentDepartmentId])
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  name                   String
  role                   Role
  departmentId           String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  resolvedAlerts         Alert[]            @relation("AlertResolver")
  setPolicies            BoardPolicy[]      @relation("PolicySetter")
  dailyEntries           DailyEntry[]
  entryComments          EntryComment[]     @relation("EntryCommentAuthor")
  editRequestsMade       EntryEditRequest[] @relation("EditRequester")
  editRequestsReviewed   EntryEditRequest[] @relation("EditReviewer")
  assignedInterventions  Intervention[]     @relation("InterventionAssignee")
  reviewedMonthlyReports MonthlyReport[]    @relation("MonthlyReportReviewer")
  approvedActions        PendingAction[]    @relation("ActionApprover")
  rejectedActions        PendingAction[]    @relation("ActionRejector")
  students               Student[]          @relation("InstructorStudents")
  department             Department         @relation(fields: [departmentId], references: [id])
  reviewedWeeklyReports  WeeklyReport[]     @relation("WeeklyReportReviewer")
  submittedSessions      YouthCodingSession[] @relation("SessionSubmitter")

  @@index([departmentId])
  @@index([role])
}

model DailyEntry {
  id                  String             @id @default(cuid())
  userId              String
  departmentId        String
  date                DateTime           @db.Date
  attendanceStatus    String
  outputCompleted     String
  blockers            String
  engagementNotes     String
  quickSummary        String
  status              EntryStatus        @default(SUBMITTED)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  averageAge          Float?
  dropouts            Int?
  engagementScore     String?
  femaleStudents      Int?
  maleStudents        Int?
  mentorshipPairs     Int?
  otherGender         Int?
  studentsPresent     Int?
  totalStudents       Int?
  reportType          String             @default("DAILY")
  studentsInvolvedIds Json?
  dropoutStudentIds   Json?
  dropoutReasons      Json?
  guestNotes          String?
  guestsVisited       Boolean            @default(false)
  alerts              Alert[]
  department          Department         @relation(fields: [departmentId], references: [id])
  user                User               @relation(fields: [userId], references: [id])
  comments            EntryComment[]
  editRequests        EntryEditRequest[]
  extractedMetrics    ExtractedMetric[]

  @@unique([userId, date])
  @@index([departmentId, date])
  @@index([status])
  @@index([date])
}

model EntryEditRequest {
  id            String            @id @default(cuid())
  entryId       String
  requestedById String
  note          String            @default("")
  status        EditRequestStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  entry         DailyEntry        @relation(fields: [entryId], references: [id])
  requestedBy   User              @relation("EditRequester", fields: [requestedById], references: [id])
  reviewedBy    User?             @relation("EditReviewer", fields: [reviewedById], references: [id])

  @@index([entryId])
  @@index([status])
  @@index([requestedById])
}

model EntryComment {
  id        String     @id @default(cuid())
  entryId   String
  authorId  String
  body      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  author    User       @relation("EntryCommentAuthor", fields: [authorId], references: [id])
  entry     DailyEntry @relation(fields: [entryId], references: [id])

  @@index([entryId])
  @@index([authorId])
}

model ExtractedMetric {
  id            String       @id @default(cuid())
  entryId       String
  metricKey     String
  metricValue   Json
  confidence    Float
  source        MetricSource
  flagged       Boolean      @default(false)
  promptVersion String
  createdAt     DateTime     @default(now())
  entry         DailyEntry   @relation(fields: [entryId], references: [id])

  @@index([entryId])
  @@index([metricKey])
  @@index([flagged])
}

model WeeklyReport {
  id               String       @id @default(cuid())
  weekStart        DateTime     @db.Date
  weekEnd          DateTime     @db.Date
  departmentId     String
  status           ReportStatus @default(DRAFT)
  generatedContent Json
  generatedMetrics Json
  risks            Json
  originalContent  Json
  editLog          Json         @default("[]")
  promptVersion    String
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  alerts           Alert[]
  department       Department   @relation(fields: [departmentId], references: [id])
  reviewedBy       User?        @relation("WeeklyReportReviewer", fields: [reviewedById], references: [id])

  @@unique([departmentId, weekStart])
  @@index([status])
  @@index([departmentId])
}

model MonthlyReport {
  id               String       @id @default(cuid())
  periodMonth      Int
  periodYear       Int
  departmentId     String
  status           ReportStatus @default(DRAFT)
  generatedContent Json
  generatedMetrics Json
  originalContent  Json
  editLog          Json         @default("[]")
  promptVersion    String
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  alerts           Alert[]
  department       Department   @relation(fields: [departmentId], references: [id])
  reviewedBy       User?        @relation("MonthlyReportReviewer", fields: [reviewedById], references: [id])

  @@unique([departmentId, periodYear, periodMonth])
  @@index([status])
  @@index([departmentId])
}

model Alert {
  id              String         @id @default(cuid())
  type            AlertType
  severity        Severity
  resolved        Boolean        @default(false)
  resolvedById    String?
  entryId         String?
  weeklyReportId  String?
  monthlyReportId String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  entry           DailyEntry?    @relation(fields: [entryId], references: [id])
  monthlyReport   MonthlyReport? @relation(fields: [monthlyReportId], references: [id])
  resolvedBy      User?          @relation("AlertResolver", fields: [resolvedById], references: [id])
  weeklyReport    WeeklyReport?  @relation(fields: [weeklyReportId], references: [id])
  interventions   Intervention[]

  @@index([severity, resolved])
  @@index([type])
  @@index([entryId])
}

model Intervention {
  id           String             @id @default(cuid())
  alertId      String
  issueType    String
  severity     Severity
  assignedToId String
  status       InterventionStatus @default(OPEN)
  notes        String             @default("")
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  alert        Alert              @relation(fields: [alertId], references: [id])
  assignedTo   User               @relation("InterventionAssignee", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([alertId])
}

model PendingAction {
  id            String              @id @default(cuid())
  departmentId  String
  actionType    String
  target        String
  priority      Int
  urgency       String
  executionMode ActionExecutionMode
  rationale     String
  payload       Json
  status        PendingActionStatus @default(PENDING)
  approvedById  String?
  rejectedById  String?
  expiresAt     DateTime
  executedAt    DateTime?
  forecastRunId String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  approvedBy    User?               @relation("ActionApprover", fields: [approvedById], references: [id])
  department    Department          @relation(fields: [departmentId], references: [id])
  rejectedBy    User?               @relation("ActionRejector", fields: [rejectedById], references: [id])

  @@index([status, expiresAt])
  @@index([departmentId, status])
  @@index([priority, status])
}

model OutcomeRecord {
  id              String     @id @default(cuid())
  departmentId    String
  forecastRunId   String
  metricKey       String
  predictedValue  Float
  actualValue     Float
  forecastHorizon String
  measuredAt      DateTime
  createdAt       DateTime   @default(now())
  department      Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId, forecastHorizon])
  @@index([forecastRunId])
}

model BoardPolicy {
  id                   String          @id @default(cuid())
  departmentId         String?
  automationLevel      AutomationLevel @default(LIMITED)
  maxAutoRiskThreshold Float           @default(0.6)
  allowedAutoActions   Json            @default("[]")
  forbiddenActions     Json            @default("[]")
  active               Boolean         @default(true)
  effectiveFrom        DateTime        @default(now())
  setByUserId          String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  department           Department?     @relation(fields: [departmentId], references: [id])
  setBy                User            @relation("PolicySetter", fields: [setByUserId], references: [id])

  @@index([active, departmentId])
}

model YouthCodingSession {
  id            String              @id @default(cuid())
  date          DateTime            @db.Date
  lessonNumber  Int
  projectName   String
  school        String
  community     String
  departmentId  String
  submittedById String
  instructorIds Json
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  department    Department          @relation(fields: [departmentId], references: [id])
  submittedBy   User                @relation("SessionSubmitter", fields: [submittedById], references: [id])
  attendance    SessionAttendance[]

  @@index([departmentId, date])
  @@index([submittedById])
}

model SessionAttendance {
  id            String             @id @default(cuid())
  sessionId     String
  studentId     String
  projectStatus ProjectStatus      @default(NOT_COMPLETE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  session       YouthCodingSession @relation(fields: [sessionId], references: [id])
  student       Student            @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

model GovernanceAuditRecord {
  id               String   @id @default(cuid())
  actionPlanId     String
  actionType       String
  departmentId     String
  decision         String
  requiredLevel    String?
  reason           String
  boardPolicyId    String?
  automationLevel  String
  forecastRunId    String
  sourceLikelihood Float
  createdAt        DateTime @default(now())

  @@index([departmentId, createdAt])
  @@index([actionPlanId])
  @@index([forecastRunId])
}

model DashboardSnapshot {
  id           String        @id @default(cuid())
  departmentId String?
  scope        SnapshotScope
  periodType   PeriodType
  periodStart  DateTime      @db.Date
  data         Json
  createdAt    DateTime      @default(now())
  department   Department?   @relation(fields: [departmentId], references: [id])

  @@index([scope, periodType, periodStart])
  @@index([departmentId])
}

enum Role {
  INSTRUCTOR
  HUB_LEAD
  BOOTCAMP_MANAGER
  PROGRAM_MANAGER
  COUNTRY_DIRECTOR
  HEAD_OF_DESIGN
  HEAD_OF_DEVELOPMENT
  YOUTH_CODING_MANAGER
  TEACHER_TRAINING_COORDINATOR
  CAREER_DEVELOPMENT_OFFICER
  REGIONAL_HUB_LEAD
  SAFEGUARDING
  M_AND_E
  MARKETING_COMMS_MANAGER
  BUSINESS_DEVELOPMENT_MANAGER
  BUSINESS_DEVELOPMENT_ASSOCIATE
  HR_OFFICER
  FINANCE_ADMIN_OFFICER
  HEAD_OF_OPERATIONS
  ADMIN
  STUDENT
}

enum EntryStatus {
  SUBMITTED
  PROCESSING
  COMPLETE
  FLAGGED
}

enum MetricSource {
  STRUCTURED
  NARRATIVE
  INFERRED
}

enum ReportStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
}

enum AlertType {
  MISSING_ENTRY
  ANOMALY
  INCONSISTENCY
  RISK
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InterventionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SnapshotScope {
  INDIVIDUAL
  DEPARTMENT
  PROGRAM
  ORGANIZATION
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum EditRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum PendingActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
}

enum ActionExecutionMode {
  AUTO
  HUMAN_APPROVAL
  SYSTEM
}

enum AutomationLevel {
  FULL
  LIMITED
  LOCKED
}

enum ProjectStatus {
  COMPLETE
  NOT_COMPLETE
}
