# ─── Database ──────────────────────────────────────────────────────────────────
# Canonical database — used by Prisma (migrations, generate, seed) and the web app.
DATABASE_URL="postgresql://user:password@localhost:5432/orgos"

# ─── AI Provider (Groq) ────────────────────────────────────────────────────────
# Get your API key at https://console.groq.com
GROQ_API_KEY=""

# ─── Cron Scheduler ────────────────────────────────────────────────────────────
# Used to authenticate cron job invocations. Generate a random string.
CRON_SECRET=""

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="OrgOS <no-reply@uncommon.org>"

# ─── App URL (used for QR codes, links in emails) ───────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# Alias for GitHub Actions workflow (APP_URL in secrets)
APP_URL="https://your-app.vercel.app"

# ─── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Demo Passwords ───────────────────────────────────────────────────────────
# JSON map of email→password for demo login. In dev, falls back to built-in defaults.
# DEMO_PASSWORDS='{"admin@uncommon.org":"admin"}'
